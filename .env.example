# 값 없이 이름만 적는다. 실제 값은 .env(gitignore)에 넣는다.
# 빈 값은 기본값을 덮지 않는다(settings가 한 함수로 읽는다).

# 출처
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# BEAUTYADS_INSTAGRAM_BASE_URL=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
DATA_GO_KR_SERVICE_KEY=

# 모델 (LiteLLM SDK 경유)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BEAUTYADS_CAP_IMAGE_USD=

# 로컬 compose
# NEO4J_PASSWORD는 8자 이상이어야 한다. 데이터 볼륨을 처음 만들 때만 적용된다(바꾸려면 볼륨 삭제).
NEO4J_PASSWORD=
POSTGRES_PASSWORD=

# 선택 compose profile obs. 프로젝트 초기화 키에도 같은 PUBLIC_KEY·SECRET_KEY를 쓴다.
# LANGFUSE_HOST= (기본 http://127.0.0.1:3001)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_PG_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_AUTH=
# LANGFUSE_MINIO_PASSWORD=

